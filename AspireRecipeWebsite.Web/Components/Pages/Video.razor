@page "/video"

<PageTitle>Video</PageTitle>

<div class="pb-24 sm:pb-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        @* Title *@
        <div class="lg:mx-0">
            <h2 class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl">Blogs Page</h2>
            <p class="text-lg/8 mt-2 text-gray-600">This is the sub-title placeholder.</p>
            @* Stats *@
            <dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-3">
                @* Stat 1 *@
                <div class="flex max-w-xs flex-col gap-y-4">
                    <dt class="text-base/7 font-normal text-gray-600">Number of Blogs Posted</dt>
                    <dd class="order-first text-xl font-semibold tracking-tight text-gray-900 sm:text-3xl">119</dd>
                </div>
                @* Stat 2 *@
                <div class="flex max-w-xs flex-col gap-y-4">
                    <dt class="text-base/7 font-normal text-gray-600">Total number of views</dt>
                    <dd class="order-first text-xl font-semibold tracking-tight text-gray-900 sm:text-3xl">44 million</dd>
                </div>
                @* Stat 3 *@
                <div class="flex max-w-xs flex-col gap-y-4">
                    <dt class="text-base/7 font-normal text-gray-600">Total blog minutes</dt>
                    <dd class="order-first text-xl font-semibold tracking-tight text-gray-900 sm:text-3xl">46,000</dd>
                </div>
            </dl>
        </div>

        <div class="mx-auto mt-10 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-20 border-t border-gray-200 pt-10 sm:mt-16 sm:pt-16 lg:mx-0 lg:max-w-none lg:grid-cols-3">
            <!-- Video Card -->

            <article class="flex max-w-xl flex-col items-start">
                <!-- Image (links to detail page) -->
                <a href="#article" class="relative block h-48 w-full overflow-hidden rounded-lg">
                    <img src="https://images.unsplash.com/photo-1496128858413-b36217c2ce36?ixlib=rb-4.0.3&auto=format&fit=crop&w=3603&q=80"
                         alt="Boost your conversion rate"
                         class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 hover:scale-105" />
                </a>

                <!-- Tag (links to tag page) -->  
                <div class="mt-3">
                    <a href="#marketing"
                       class="group inline-flex items-center gap-2 rounded-full border border-gray-600/60 bg-gray-100 px-3 py-1.5 text-sm font-medium transition-all duration-300 hover:border-blue-600/60 hover:bg-blue-200">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="stroke-current h-4 w-4 text-gray-600 transition-colors duration-300 group-hover:text-blue-500"
                             fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                        </svg>

                        <span class="pt-0.5 text-gray-600 transition-colors duration-300 group-hover:text-blue-500 group-hover:underline group-hover:underline-offset-2">
                            Marketing
                        </span>
                    </a>
                </div>

                <!-- Title & Description (links to detail page) -->
                <div class="group mt-1 w-full">
                    <a href="#article" class="block">
                        <h4 class="mt-1 text-lg font-semibold text-gray-900 transition-colors group-hover:text-gray-600">
                            Boost your conversion rate
                        </h4>
                        <p class="mt-1 line-clamp-3 text-sm text-gray-600 transition-colors group-hover:text-gray-500">
                            Illo sint voluptas. Error voluptates culpa eligendi. Hic vel totam vitae illo. Non aliquid explicabo necessitatibus unde. Sed exercitationem placeat consectetur nulla deserunt vel. Iusto corrupti dicta.
                        </p>
                    </a>
                </div>

                <!-- Author Info -->
                <div class="relative mt-3 flex gap-4">
                    <img src="https://images.unsplash.com/photo-1519244703995-f4e0f30006d5?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
                         alt="Profile picture of Author"
                         class="h-10 w-10 rounded-full bg-gray-100" />
                    <div class="text-sm/6 mb-0.5">
                        <div class="font-semibold text-gray-900">
                            <a href="#MichaelFoster" class="text-gray-900 transition-all duration-300 group-hover:underline group-hover:text-shadow-glow">
                                <span class="absolute inset-0"></span>
                                Michael Foster
                            </a>
                            <p class="font-normal text-gray-500">Mar 16, 2020</p>
                        </div>
                    </div>
                </div>

            </article>

            <!-- Repeat other blog cards here... -->

        </div>
    </div>
</div>

